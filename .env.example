# Copy to .env (git-ignored).
DATABASE_URL="postgresql://lms:lms_pass@localhost:5432/lms_db?schema=public"

# Signs session cookies. Use a long random string, e.g.  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-of-at-least-32-characters"

# Seed users (npm run db:seed). Leave unset to skip creating them.
SEED_INSTRUCTOR_EMAIL="instructor@example.com"
SEED_STUDENT_EMAIL="student@example.com"
SEED_PASSWORD="Learn-more-1234"
